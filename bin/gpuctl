#!/usr/bin/python3
"""gpuctl — command-line backend for the GPU Omarchy plugin.

Standard library only: no daemon, no background process. Each invocation
queries the GPU and exits.

Supported:
  NVIDIA  via nvidia-smi (load, VRAM, temp, power, clocks, fan, processes)
  AMD     via /sys/class/drm/card*/device (amdgpu: busy %, VRAM, hwmon)
  Intel   via /proc/*/fdinfo and /sys/class/drm/card*/device
          (i915/xe: engine busy %, processes, frequency, hwmon)

Usage:
  gpuctl get [--json]        current state for the first/selected GPU
  gpuctl list [--json]       every GPU discovered
  gpuctl doctor              check every link from the driver to the bar
"""

import argparse
import glob
import json
import os
import re
import select
import shutil
import time
import subprocess
import sys
import tempfile

PLUGIN_ID = "dansmith888.gpu"
REPO_URL = "https://github.com/DanSmith888/omarchy-gpu.git"
REQUIRED_FILES = ("manifest.json", "BarWidget.qml", "Panel.qml", "Model.js",
                  "Sparkline.qml", "bin/gpustatus", "bin/gpuctl")

TIMEOUT = 4
# Ceiling on what any one command may hand back. nvidia-smi -q grows with the
# number of GPU clients, and this is parsed inside the shell process.
MAX_OUTPUT = 262144
TOP_DEFAULT = 5
# Longest process name we hand to the UI; anything longer is a command line,
# not a name.
NAME_MAX = 24
# Hard cardinality caps. nvidia-smi output is trusted only as far as these:
# every accepted GPU row costs two further commands, so the row count is
# bounded before any per-GPU work starts.
MAX_GPUS = 8
MAX_PROCS_PER_GPU = 32
FIELD_MAX = 64
# Ceiling on any single /proc or /sys read.
MAX_FILE_BYTES = 65536

# A process name is whatever a local program chose to call itself, and it ends
# up in the panel and in the bar's tooltip, which renders with a Text that
# auto-detects rich text. Keep a conservative printable subset so a name can
# never carry markup into a UI sink.
_NAME_OK = re.compile(r"[^A-Za-z0-9 ._+@:-]")


def safe_name(value, limit=NAME_MAX):
    out = _NAME_OK.sub("", str(value or ""))[:limit].strip()
    return out or "?"

# One nvidia-smi call for everything the panel shows.
NV_FIELDS = [
    "index", "name", "driver_version", "utilization.gpu", "utilization.memory",
    "memory.used", "memory.total", "temperature.gpu", "power.draw",
    "power.limit", "clocks.gr", "clocks.max.gr", "clocks.mem", "fan.speed",
    "pstate",
]


def run(cmd, timeout=TIMEOUT, limit=MAX_OUTPUT):
    """stdout on success, None on any failure. Never raises, never hangs.

    Reads at most `limit` bytes, and enforces `timeout` across the whole read
    rather than only around process exit: a command that produces nothing and
    never exits would otherwise block the caller for as long as it liked.
    nvidia-smi -q grows with the number of GPU clients, and this runs inside
    the shell process on a timer, so both bounds matter.
    """
    proc = None
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL)
        fd = proc.stdout.fileno()
        deadline = time.monotonic() + timeout
        chunks, total, truncated = [], 0, False
        while total < limit:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            if not select.select([fd], [], [], remaining)[0]:
                break
            chunk = os.read(fd, min(65536, limit - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        else:
            truncated = True

        proc.stdout.close()
        try:
            rc = proc.wait(timeout=0.5)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=1)
            rc = None

        if not chunks:
            return None
        # Truncated output is still worth parsing; output from a command that
        # failed outright is not.
        if rc == 0 or truncated:
            return b"".join(chunks).decode("utf-8", "replace")
        return None
    except Exception:
        if proc is not None:
            try:
                proc.kill()
            except Exception:
                pass
        return None


def read(path):
    """File contents, capped. Never raises.

    Bounded because a sysfs or proc path can be replaced with something much
    larger, and this runs on a timer inside the shell process.
    """
    try:
        with open(path) as f:
            return f.read(MAX_FILE_BYTES)
    except OSError:
        return None


def read_int(path):
    raw = read(path)
    if raw is None:
        return None
    try:
        return int(raw.strip())
    except ValueError:
        return None


def to_num(text):
    """'24.06' -> 24.06; '[N/A]', '', None -> None."""
    if text is None:
        return None
    t = str(text).strip()
    if t == "" or t.startswith("[") or t.lower() in ("n/a", "not supported", "unknown"):
        return None
    try:
        v = float(t)
    except ValueError:
        return None
    return int(v) if v.is_integer() else round(v, 2)


# ---- NVIDIA -------------------------------------------------------------

def nvidia_available():
    return shutil.which("nvidia-smi") is not None


def nvidia_list():
    if not nvidia_available():
        return []
    out = run(["nvidia-smi", "--query-gpu=" + ",".join(NV_FIELDS),
               "--format=csv,noheader,nounits"])
    if not out:
        return []
    gpus = []
    for line in out.strip().splitlines():
        if len(gpus) >= MAX_GPUS:
            break
        parts = [p.strip() for p in line.split(",")]
        if len(parts) < len(NV_FIELDS):
            continue
        f = dict(zip(NV_FIELDS, parts))
        gpus.append({
            "vendor": "NVIDIA",
            "index": to_num(f["index"]) or 0,
            "name": safe_name(f["name"], FIELD_MAX),
            "driver": safe_name(f["driver_version"], FIELD_MAX) if f["driver_version"] else None,
            "load": to_num(f["utilization.gpu"]),
            "memLoad": to_num(f["utilization.memory"]),
            "memUsedMiB": to_num(f["memory.used"]),
            "memTotalMiB": to_num(f["memory.total"]),
            "tempC": to_num(f["temperature.gpu"]),
            "powerW": to_num(f["power.draw"]),
            "powerLimitW": to_num(f["power.limit"]),
            "clockMhz": to_num(f["clocks.gr"]),
            "maxClockMhz": to_num(f["clocks.max.gr"]),
            "memClockMhz": to_num(f["clocks.mem"]),
            "fanPct": to_num(f["fan.speed"]),
            "pstate": safe_name(f["pstate"], 8) if f["pstate"] else None,
        })
    return gpus


def nvidia_processes(index, top_n=TOP_DEFAULT):
    """[{pid, name, memMiB}] — graphics and compute clients, biggest first."""
    # -i scopes both queries to one card. Without it every GPU on a
    # multi-GPU machine was handed the same client list.
    gpu = str(int(index))
    out = run(["nvidia-smi", "-i", gpu, "--query-compute-apps=pid,used_memory",
               "--format=csv,noheader,nounits"])
    procs = {}
    if out:
        for line in out.strip().splitlines():
            parts = [p.strip() for p in line.split(",")]
            if len(parts) < 2:
                continue
            pid = to_num(parts[0])
            if pid is None:
                continue
            procs[int(pid)] = to_num(parts[-1]) or 0

    # -q -d PIDS also lists graphics clients, which the query API omits.
    out = run(["nvidia-smi", "-i", gpu, "-q", "-d", "PIDS"])
    if out:
        pid = None
        for line in out.splitlines():
            m = re.match(r"\s*Process ID\s*:\s*(\d+)", line)
            if m:
                pid = int(m.group(1))
                continue
            m = re.match(r"\s*Used GPU Memory\s*:\s*(\d+)", line)
            if m and pid is not None:
                procs[pid] = max(procs.get(pid, 0), int(m.group(1)))
                pid = None

    out_list = []
    for pid, mem in procs.items():
        name = proc_name(pid)
        if name:
            out_list.append({"pid": pid, "name": name, "memMiB": mem})
    out_list.sort(key=lambda p: (-(p["memMiB"] or 0), p["pid"]))
    return out_list[:min(top_n, MAX_PROCS_PER_GPU)]


def proc_name(pid):
    """A short, readable name for a pid, or None once it has exited.

    argv[0] needs care: Chromium and friends rewrite their cmdline as one
    space-separated string rather than NUL-separated argv, so splitting on NUL
    alone hands back the entire 400-character command line.
    """
    raw = read(f"/proc/{pid}/comm")
    comm = raw.strip() if raw else ""
    cmd = read(f"/proc/{pid}/cmdline")
    if cmd:
        first = cmd.split("\0", 1)[0]
        first = first.split()[0] if first.strip() else ""
        base = os.path.basename(first)[:NAME_MAX]
        if base and (len(comm) >= 15 or base.startswith(comm)):
            return safe_name(base)
    return safe_name(comm) if comm else None


# ---- NVIDIA runtime power management (RTD3) ------------------------------
#
# On hybrid laptops the NVIDIA GPU powers itself off (runtime D3 / D3cold)
# after a few seconds without clients. Every nvidia-smi call is a client: it
# opens /dev/nvidia*, wakes a suspended GPU, and restarts the idle timer. A
# bar widget polling every few seconds therefore keeps the dGPU awake forever
# (several watts, all day). So nvidia-smi only runs when the GPU is already
# awake for a reason of its own; the power state itself comes from sysfs,
# which never touches the device.

# While awake with no client we can see (the idle timeout before the driver
# suspends the card, or a root/container workload whose fds we cannot read),
# query at most this often and serve the cached reading in between. Any query
# restarts that idle timeout, so this has to be longer than it: measured at a
# few seconds on the card this was written for (active -> suspended in under
# 10 s), and 20 s leaves 2x margin. If a card's timeout is longer, this value
# is what to raise.
AWAKE_UNSEEN_QUERY_S = 20
# pci.ids is ~40k lines; anything far beyond that is not the file we expect.
PCI_IDS_MAX_LINES = 200000
_NV_CLIENT_DEV = re.compile(r"^/dev/nvidia(\d+|-uvm)$")


def _cache_path(name):
    """Per-session cache file, or None: never fall back to a shared /tmp."""
    base = os.environ.get("XDG_RUNTIME_DIR")
    return os.path.join(base, f"omarchy-gpu-{name}.json") if base else None


def _cache_read(name):
    """The cached JSON object, or None when absent or unreadable."""
    path = _cache_path(name)
    raw = read(path) if path else None
    try:
        data = json.loads(raw) if raw else None
    except (ValueError, TypeError):
        return None
    return data if isinstance(data, dict) else None


def _cache_write(name, data):
    """Replace the cache file atomically, in a private temp file beside it."""
    path = _cache_path(name)
    if not path:
        return
    tmp = None
    try:
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path),
                                   prefix=".omarchy-gpu-", suffix=".tmp")
        with os.fdopen(fd, "w") as f:
            json.dump(data, f)
        os.replace(tmp, path)
    except OSError:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass


def _cache_load():
    """(timestamp, [gpu dicts]) from the last nvidia-smi reading."""
    data = _cache_read("nvidia") or {}
    try:
        gpus = data.get("gpus")
        gpus = [g for g in gpus if isinstance(g, dict)][:MAX_GPUS] if isinstance(gpus, list) else []
        return float(data.get("t", 0)), gpus
    except (ValueError, TypeError, AttributeError):
        return 0.0, []


def _cache_save(t, gpus):
    _cache_write("nvidia", {"t": t, "gpus": gpus})


def nvidia_pci_power():
    """[(slot, power_control, runtime_status)] for NVIDIA display-class functions.

    vendor/class are cached by the kernel, and power/control and
    runtime_status are PM core state: reading them never resumes the device.
    power/control is "auto" only when userspace handed the device to runtime
    PM; with "on" (the default on desktops) the card can never suspend, so
    there is nothing to protect and every poll can query.
    """
    out = []
    for dev in sorted(glob.glob("/sys/bus/pci/devices/*")):
        if (read(os.path.join(dev, "vendor")) or "").strip() != "0x10de":
            continue
        if not (read(os.path.join(dev, "class")) or "").strip().startswith("0x03"):
            continue
        control = (read(os.path.join(dev, "power", "control")) or "").strip()
        status = (read(os.path.join(dev, "power", "runtime_status")) or "").strip()
        out.append((os.path.basename(dev), control, status))
    return out


def nvidia_has_visible_client():
    """True if a process we can inspect has an NVIDIA compute/render device open."""
    me = os.getpid()
    for d in glob.glob("/proc/[0-9]*"):
        try:
            pid = int(os.path.basename(d))
        except ValueError:
            continue
        if pid == me or (read(os.path.join(d, "comm")) or "").strip() == "nvidia-smi":
            continue
        try:
            fds = os.listdir(os.path.join(d, "fd"))
        except OSError:
            continue          # another user's process, or gone
        for fd in fds:
            try:
                if _NV_CLIENT_DEV.match(os.readlink(os.path.join(d, "fd", fd))):
                    return True
            except OSError:
                continue
    return False


def ec_gpu_temp():
    """GPU temperature from a non-NVIDIA hwmon (e.g. legion_hwmon, via the EC)."""
    for label in glob.glob("/sys/class/hwmon/hwmon*/temp*_label"):
        if (read(os.path.join(os.path.dirname(label), "name")) or "").strip() == "nvidia":
            continue
        if (read(label) or "").strip().lower() == "gpu temperature":
            milli = read_int(label[:-len("_label")] + "_input")
            if milli is not None and 0 < milli < 150000:
                return round(milli / 1000.0, 1)
    return None


def pci_ids_name(slot):
    """'NVIDIA GeForce RTX 5090 Max-Q Mobile' from hwdata's pci.ids, or None.

    Device ids come from sysfs (cached by the kernel), so unlike lspci this
    never reads config space of a suspended device.
    """
    dev = (read(f"/sys/bus/pci/devices/{slot}/device") or "").strip().lower()
    if not dev.startswith("0x"):
        return None
    want, in_vendor = dev[2:], False
    for ids in ("/usr/share/hwdata/pci.ids", "/usr/share/misc/pci.ids"):
        try:
            with open(ids, encoding="utf-8", errors="replace") as f:
                for n, line in enumerate(f):
                    if n >= PCI_IDS_MAX_LINES:
                        break
                    if line.startswith("10de "):
                        in_vendor = True
                        continue
                    if in_vendor and line[:1] not in ("\t", "#", "\n"):
                        break
                    if in_vendor and line.startswith("\t" + want + "  "):
                        name = line.split("  ", 1)[1].strip()
                        m = re.search(r"\[([^\]]+)\]", name)
                        name = (m.group(1) if m else name).replace(" / ", " ")
                        return safe_name("NVIDIA " + name, FIELD_MAX)
        except OSError:
            continue
    return None


def nvidia_sleeping(cached, power):
    """Entries for a suspended GPU, built without touching it."""
    driver = (read("/sys/module/nvidia/version") or "").strip() or None
    temp = ec_gpu_temp()
    gpus = []
    for i, prev in enumerate(cached or [{"index": n} for n in range(len(power))]):
        gpus.append({
            "vendor": "NVIDIA",
            "index": prev.get("index", i),
            "name": prev.get("name") or (pci_ids_name(power[i][0])
                                        if i < len(power) else None) or "NVIDIA GPU",
            "driver": safe_name(driver, FIELD_MAX) if driver else prev.get("driver"),
            "load": 0,
            "memLoad": None,
            "memUsedMiB": 0,
            "memTotalMiB": prev.get("memTotalMiB"),
            "tempC": temp,
            "powerW": 0,
            "powerLimitW": prev.get("powerLimitW"),
            "clockMhz": None,
            "maxClockMhz": prev.get("maxClockMhz"),
            "memClockMhz": None,
            "fanPct": None,
            "pstate": "D3cold",
            "processes": [],
        })
    return gpus


def nvidia_gpus(top_n=TOP_DEFAULT):
    """NVIDIA entries, querying nvidia-smi only when that cannot wake the GPU."""
    if not nvidia_available():
        return []
    power = nvidia_pci_power()
    statuses = {status for _, _, status in power}
    # Only cards handed to runtime PM can suspend at all; with "on" (desktops)
    # or "unsupported", polling cannot keep the card awake, so query every
    # time and never serve a cached reading.
    may_sleep = bool(power) and all(control == "auto" and status != "unsupported"
                                    for _, control, status in power) and statuses
    cached_t, cached = _cache_load()
    now = time.time()

    if may_sleep and statuses <= {"suspended", "suspending"}:
        gpus = nvidia_sleeping(cached, power)
        if not cached:
            # Remember the pci.ids name so it is looked up once, not per
            # poll. t=0 keeps the awake path from treating this as fresh.
            _cache_save(0, gpus)
        return gpus

    if may_sleep and cached and not nvidia_has_visible_client():
        if now - cached_t < AWAKE_UNSEEN_QUERY_S:
            return cached

    gpus = nvidia_list()
    for g in gpus:
        g["processes"] = nvidia_processes(g["index"], top_n)
    if gpus:
        _cache_save(now, gpus)
    return gpus


# ---- AMD / Intel via sysfs ---------------------------------------------

def sysfs_hwmon(device_dir):
    """{'tempC','powerW','fanPct'} from the card's hwmon node."""
    out = {"tempC": None, "powerW": None, "fanPct": None}
    for hw in glob.glob(os.path.join(device_dir, "hwmon", "hwmon*")):
        milli = read_int(os.path.join(hw, "temp1_input"))
        if milli is not None and out["tempC"] is None:
            out["tempC"] = round(milli / 1000.0, 1)
        micro = read_int(os.path.join(hw, "power1_average"))
        if micro is None:
            micro = read_int(os.path.join(hw, "power1_input"))
        if micro is not None and out["powerW"] is None:
            out["powerW"] = round(micro / 1000000.0, 1)
        rpm = read_int(os.path.join(hw, "fan1_input"))
        pwm = read_int(os.path.join(hw, "pwm1"))
        if out["fanPct"] is None and pwm is not None:
            out["fanPct"] = round(100.0 * pwm / 255.0)
        elif out["fanPct"] is None and rpm is not None:
            out["fanPct"] = None
    return out


# ---- Intel load via DRM fdinfo ------------------------------------------
#
# amdgpu publishes a ready-made gpu_busy_percent; i915 and xe do not. What
# they do publish is per-client accounting in /proc/<pid>/fdinfo/<fd> for
# every open render node: how long each engine spent on that client's work.
# Load is therefore the engine time all clients consumed since the previous
# poll over the time elapsed, and the same numbers give the process list.
# xe counts in GPU ticks (drm-cycles-* busy, drm-total-cycles-* elapsed);
# i915 counts in nanoseconds (drm-engine-* busy, against wall time).
#
# Reading another process's fdinfo needs ptrace access, so only the user's
# own clients count. On a single-user desktop that is the compositor and
# everything it draws, which is what the widget is for. When no client is
# readable at all, the GT's idle-state residency gives a whole-card figure
# instead: a GT not in C6 is running something.
#
# The previous sample lives in a per-session cache file, like the NVIDIA one.

_DRM_PDEV = re.compile(r"^drm-pdev:\s*(\S+)", re.M)
_DRM_CLIENT = re.compile(r"^drm-client-id:\s*(\d+)", re.M)
_DRM_CYCLES = re.compile(r"^drm-cycles-(\w+):\s*(\d+)", re.M)
_DRM_TOTAL_CYCLES = re.compile(r"^drm-total-cycles-(\w+):\s*(\d+)", re.M)
_DRM_ENGINE_NS = re.compile(r"^drm-engine-(\w+):\s*(\d+)\s*ns", re.M)
_DRM_RESIDENT = re.compile(r"^drm-resident-(\w+):\s*(\d+)\s*(KiB|MiB|GiB)?", re.M)
_DRM_UNIT = {None: 1, "": 1, "KiB": 1024, "MiB": 1048576, "GiB": 1073741824}
# Bound on clients read per poll; a desktop has a few dozen.
MAX_DRM_CLIENTS = 256


def drm_clients(slot):
    """{client_id: {pid, cycles, total, ns, memBytes}} for the card at PCI `slot`.

    Walks /proc/*/fd for links into /dev/dri and reads the fdinfo behind
    each one. readlink is cheap and fdinfo is not, so only DRM fds are read.
    A client that is open on several fds (dup, fork) appears once.
    """
    clients = {}
    for fd_dir in glob.glob("/proc/[0-9]*/fd"):
        pid = fd_dir.split("/")[2]
        try:
            fds = os.listdir(fd_dir)
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink(os.path.join(fd_dir, fd))
            except OSError:
                continue
            if not target.startswith("/dev/dri/"):
                continue
            info = read(f"/proc/{pid}/fdinfo/{fd}")
            if not info:
                continue
            m = _DRM_PDEV.search(info)
            if not m or m.group(1) != slot:
                continue
            m = _DRM_CLIENT.search(info)
            if not m or m.group(1) in clients:
                continue
            clients[m.group(1)] = {
                "pid": int(pid),
                "cycles": {e: int(v) for e, v in _DRM_CYCLES.findall(info)},
                "total": {e: int(v) for e, v in _DRM_TOTAL_CYCLES.findall(info)},
                "ns": {e: int(v) for e, v in _DRM_ENGINE_NS.findall(info)},
                "memBytes": sum(int(v) * _DRM_UNIT.get(u, 1)
                                for _, v, u in _DRM_RESIDENT.findall(info)),
            }
            if len(clients) >= MAX_DRM_CLIENTS:
                return clients
    return clients


def gt_idle_ms(card):
    """Idle-state residency of the first GT in ms: xe gtidle, else i915 rc6."""
    for path in sorted(glob.glob(os.path.join(card, "device", "tile*", "gt*",
                                              "gtidle", "idle_residency_ms"))):
        v = read_int(path)
        if v is not None:
            return v
    return read_int(os.path.join(card, "gt", "gt0", "rc6_residency_ms"))


def _client_busy(now, prev_t, cur, prev):
    """Busy % per engine for one client between two samples."""
    busy = {}
    for eng, ticks in cur["cycles"].items():
        d_total = cur["total"].get(eng, 0) - prev.get("total", {}).get(eng, 0)
        if d_total > 0:
            busy[eng] = 100.0 * (ticks - prev.get("cycles", {}).get(eng, 0)) / d_total
    elapsed_ns = (now - prev_t) * 1e9
    if elapsed_ns > 0:
        for eng, ns in cur["ns"].items():
            busy[eng] = 100.0 * (ns - prev.get("ns", {}).get(eng, 0)) / elapsed_ns
    return {e: min(max(v, 0.0), 100.0) for e, v in busy.items()}


def drm_load(card, slot, top_n=TOP_DEFAULT):
    """(load %, per-engine %, processes, resident bytes) from fdinfo deltas.

    load is the busiest engine, the figure nvtop and intel_gpu_top head with.
    Resident bytes sum over every readable client, not only the listed ones.
    The first poll after login has nothing to diff against and returns
    (None, {}, None, None); the widget shows a dash for one interval.
    """
    now = time.monotonic()
    clients = drm_clients(slot)
    idle = gt_idle_ms(card)
    cache = _cache_read("drm") or {}
    prev = cache.get(slot) if isinstance(cache.get(slot), dict) else None
    cache[slot] = {"t": now, "idle": idle,
                   "clients": {cid: {"cycles": c["cycles"], "total": c["total"], "ns": c["ns"]}
                               for cid, c in clients.items()}}
    _cache_write("drm", cache)
    if not prev:
        return None, {}, None, None
    prev_t = float(prev.get("t", 0))
    prev_clients = prev.get("clients") or {}

    engines = {}
    per_pid = {}
    for cid, c in clients.items():
        p = prev_clients.get(cid)
        if not isinstance(p, dict):
            continue
        busy = _client_busy(now, prev_t, c, p)
        for eng, v in busy.items():
            engines[eng] = engines.get(eng, 0.0) + v
        row = per_pid.setdefault(c["pid"], {"loadPct": 0.0, "memBytes": 0})
        row["loadPct"] += max(busy.values(), default=0.0)
        row["memBytes"] += c["memBytes"]
    engines = {e: round(min(v, 100.0), 1) for e, v in engines.items()}

    procs = []
    for pid, row in per_pid.items():
        name = proc_name(pid)
        if name:
            procs.append({"pid": pid, "name": name,
                          "memMiB": round(row["memBytes"] / 1048576.0),
                          "loadPct": round(min(row["loadPct"], 100.0), 1)})
    procs.sort(key=lambda p: (-p["loadPct"], -(p["memMiB"] or 0), p["pid"]))
    procs = procs[:min(top_n, MAX_PROCS_PER_GPU)]
    resident = sum(c["memBytes"] for c in clients.values())

    if engines:
        return round(max(engines.values())), engines, procs, resident
    # No readable client: a whole-card figure from idle residency instead.
    if idle is not None and prev.get("idle") is not None and now > prev_t:
        idle_frac = (idle - prev["idle"]) / ((now - prev_t) * 1000.0)
        return round(100.0 * min(max(1.0 - idle_frac, 0.0), 1.0)), {}, procs, resident
    return None, {}, procs, resident


def intel_clocks(card):
    """(requested MHz, max MHz) for the first GT: xe freq0, else i915 card attrs.

    The requested clock, not the actual one: act_freq reads 0 whenever the GT
    is powered down between frames, which on a desktop is most of the time.
    """
    for gt in sorted(glob.glob(os.path.join(card, "device", "tile*", "gt*", "freq0"))):
        cur = read_int(os.path.join(gt, "cur_freq"))
        if cur is not None:
            return cur, read_int(os.path.join(gt, "rp0_freq"))
    cur = read_int(os.path.join(card, "gt_cur_freq_mhz"))
    return cur, (read_int(os.path.join(card, "gt_RP0_freq_mhz")) if cur is not None else None)


def sysfs_list(top_n=TOP_DEFAULT):
    """AMD and Intel cards from /sys/class/drm. Empty when nothing matches."""
    gpus = []
    for card in sorted(glob.glob("/sys/class/drm/card[0-9]*")):
        if "-" in os.path.basename(card):   # connectors, not cards
            continue
        dev = os.path.join(card, "device")
        uevent = read(os.path.join(dev, "uevent")) or ""
        driver = ""
        m = re.search(r"^DRIVER=(.+)$", uevent, re.M)
        if m:
            driver = m.group(1).strip()
        if driver not in ("amdgpu", "i915", "xe", "radeon"):
            continue

        vendor = "AMD" if driver in ("amdgpu", "radeon") else "Intel"
        load = read_int(os.path.join(dev, "gpu_busy_percent"))
        used = read_int(os.path.join(dev, "mem_info_vram_used"))
        total = read_int(os.path.join(dev, "mem_info_vram_total"))
        slot = os.path.basename(os.path.realpath(dev))
        engines = {}
        # No per-process VRAM accounting on AMD; null hides the list.
        processes = None
        clock = None
        max_clock = None
        raw = read(os.path.join(dev, "pp_dpm_sclk")) or ""
        for line in raw.splitlines():
            m = re.search(r"(\d+)\s*Mhz", line, re.I)
            if m:
                max_clock = int(m.group(1))
                if line.strip().endswith("*"):
                    clock = int(m.group(1))
        if vendor == "Intel":
            load, engines, processes, resident = drm_load(card, slot, top_n)
            clock, max_clock = intel_clocks(card)
            if used is None and resident:
                # Integrated graphics share system RAM: this is what the
                # readable clients hold, with no total to set it against.
                used = resident

        hw = sysfs_hwmon(dev)
        gpus.append({
            "vendor": vendor,
            "index": len(gpus),
            "name": gpu_name(dev, vendor, driver),
            "driver": driver,
            "pdev": slot,
            "load": load,
            "engines": engines,
            "memLoad": None,
            "memUsedMiB": round(used / 1048576.0) if used else None,
            "memTotalMiB": round(total / 1048576.0) if total else None,
            "tempC": hw["tempC"],
            "powerW": hw["powerW"],
            "powerLimitW": None,
            "clockMhz": clock,
            "maxClockMhz": max_clock,
            "memClockMhz": None,
            "fanPct": hw["fanPct"],
            "pstate": None,
            "processes": processes,
        })
    return gpus


def gpu_name(dev, vendor, driver):
    """Marketing-ish name from lspci, falling back to the PCI id."""
    slot = os.path.basename(os.path.realpath(dev))
    out = run(["lspci", "-s", slot])
    if out:
        line = out.strip().splitlines()[0] if out.strip() else ""
        # "00:02.0 VGA compatible controller: Intel Corporation ..." — the
        # slot has colons of its own, so skip it before looking for the class.
        m = re.match(r"^\S+\s+[^:]+:\s*(.+)$", line)
        if m:
            name = m.group(1)
            name = re.sub(r"\s*\(rev [0-9a-f]+\)$", "", name)
            return safe_name(name, FIELD_MAX)
    return f"{vendor} GPU ({driver})"


# ---- assembly -----------------------------------------------------------

def list_gpus(top_n=TOP_DEFAULT):
    gpus = nvidia_gpus(top_n)[:MAX_GPUS]
    gpus.extend(sysfs_list(top_n))
    return gpus[:MAX_GPUS]


def get(index=0, top_n=TOP_DEFAULT):
    gpus = list_gpus(top_n)
    if not gpus:
        return None
    pick = gpus[0]
    for g in gpus:
        if g["index"] == index:
            pick = g
            break
    state = dict(pick)
    state["present"] = True
    state["count"] = len(gpus)
    state["gpus"] = [{"index": g["index"], "name": g["name"], "vendor": g["vendor"]}
                     for g in gpus[:MAX_GPUS]]
    return state


# ---- doctor -------------------------------------------------------------

def doctor():
    checks = []

    def add(ok, label, detail="", fix=""):
        checks.append((ok, label, detail, fix))

    add(bool(glob.glob("/sys/class/drm/card[0-9]*")), "DRM cards present",
        ", ".join(os.path.basename(c) for c in sorted(glob.glob("/sys/class/drm/card[0-9]*"))
                  if "-" not in os.path.basename(c)),
        "no GPU exposed by the kernel; nothing to show")

    if nvidia_available():
        gpus = nvidia_list()
        add(bool(gpus), "nvidia-smi answers",
            f"{len(gpus)} GPU(s)" if gpus else "nvidia-smi ran but returned nothing",
            "check the driver: nvidia-smi")
    else:
        add(True, "nvidia-smi", "not installed; NVIDIA readings unavailable")

    sysg = sysfs_list()
    add(True, "sysfs GPUs",
        ", ".join(f"{g['vendor']} {g['driver']}" for g in sysg) if sysg
        else "no amdgpu/i915/xe card; AMD and Intel readings unavailable")
    for g in sysg:
        if g["vendor"] != "Intel":
            continue
        clients = len(drm_clients(g["pdev"]))
        add(clients > 0, "Intel DRM clients readable",
            f"{clients} client fd(s) in /proc/*/fdinfo; engines: "
            + (", ".join(f"{e} {v}%" for e, v in sorted(g["engines"].items()))
               or "no delta yet, poll again"),
            "no readable DRM client; load falls back to GT idle residency")

    state = get()
    add(state is not None, "Readings available",
        f"{state['name']}: load {state['load']}%, "
        + (f"{state['memUsedMiB']}/{state['memTotalMiB']} MiB" if state["memTotalMiB"] is not None
           else f"{state['memUsedMiB']} MiB")
        if state else "",
        "install the vendor driver tools (nvidia-utils for NVIDIA)")

    plug = os.path.expanduser("~/.config/omarchy/plugins/" + PLUGIN_ID)
    add(os.path.isdir(plug), "Plugin installed", plug,
        "omarchy plugin add " + REPO_URL + " --enable")
    missing = [f for f in REQUIRED_FILES if not os.path.exists(os.path.join(plug, f))]
    add(not missing, "Plugin files present",
        "missing: " + ", ".join(missing) if missing else "",
        "omarchy plugin update " + PLUGIN_ID)

    try:
        with open(os.path.expanduser("~/.config/omarchy/shell.json")) as f:
            layout = json.load(f).get("bar", {}).get("layout", {})
        placed = any(PLUGIN_ID == w.get("id")
                     for sec in layout.values() for w in sec if isinstance(w, dict))
    except (OSError, ValueError, AttributeError):
        placed = False
    add(placed, "Widget placed in the bar", "",
        "omarchy plugin enable " + PLUGIN_ID + " --section right")

    width = max(len(c[1]) for c in checks)
    failed = 0
    for ok, label, detail, fix in checks:
        mark = "ok  " if ok else "FAIL"
        line = f"  [{mark}] {label.ljust(width)}"
        if detail:
            line += f"  {detail}"
        print(line)
        if not ok and fix:
            print(f"         -> {fix}")
        failed += 0 if ok else 1
    print()
    if failed:
        print(f"  {failed} check(s) failed.")
    else:
        print("  All checks passed. If the widget is still missing, give it "
              "5s to poll, then: omarchy restart shell")
    return 1 if failed else 0


# ---- CLI ---------------------------------------------------------------

def print_human(state):
    print(f"  {state['name']}  ({state['vendor']}, driver {state['driver'] or '-'})")
    rows = [
        ("load", f"{state['load']}%" if state["load"] is not None else None),
        ("vram", (f"{state['memUsedMiB']} / {state['memTotalMiB']} MiB"
                  if state["memTotalMiB"] is not None else f"{state['memUsedMiB']} MiB")
                 if state["memUsedMiB"] is not None else None),
        ("temp", f"{state['tempC']}°C" if state["tempC"] is not None else None),
        ("power", f"{state['powerW']} / {state['powerLimitW']} W"
                  if state["powerW"] is not None else None),
        ("clock", f"{state['clockMhz']} MHz" if state["clockMhz"] is not None else None),
        ("memclk", f"{state['memClockMhz']} MHz" if state["memClockMhz"] is not None else None),
        ("fan", f"{state['fanPct']}%" if state["fanPct"] is not None else None),
        ("pstate", state["pstate"]),
        ("engines", "  ".join(f"{e} {v}%" for e, v in sorted(state["engines"].items()))
                    if state.get("engines") else None),
    ]
    width = max(len(r[0]) for r in rows)
    for label, value in rows:
        if value is not None:
            print(f"  {label.ljust(width)}  {value}")
    if state.get("processes"):
        print("  clients")
        for p in state["processes"]:
            load = f"{p['loadPct']:>5}%" if p.get("loadPct") is not None else "      "
            print(f"    {load}  {p['memMiB']:>6} MiB  {p['pid']:>7}  {p['name']}")


def main():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="machine-readable output")

    ap = argparse.ArgumentParser(prog="gpuctl", parents=[common],
                                 description=__doc__.split("\n\n")[1])
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("get", parents=[common])
    p.add_argument("-i", "--index", type=int, default=0)
    sub.add_parser("list", parents=[common])
    sub.add_parser("doctor", parents=[common])

    args = ap.parse_args()
    as_json = getattr(args, "json", False)

    if args.cmd == "doctor":
        return doctor()

    if args.cmd == "list":
        gpus = list_gpus()
        if as_json:
            print(json.dumps(gpus))
        else:
            for g in gpus:
                print(f"  [{g['index']}] {g['vendor']:6} {g['name']}")
        return 0

    if args.cmd == "get":
        state = get(args.index)
        if state is None:
            raise SystemExit("gpuctl: no GPU found")
        if as_json:
            print(json.dumps(state))
        else:
            print_human(state)
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
